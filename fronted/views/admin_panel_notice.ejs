<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload Notice</title>
  <link rel="stylesheet" href="/admin_panel_notice.css">
</head>
<body>

<div class="upload-wrapper">
  <div class="upload-card">
    <h1>Upload Notice</h1>
    <p class="subtitle">Add a notice with an image. Make sure all fields are filled.</p>

    <form action="/admin_panel/notice" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="title">Notice Title</label>
        <input type="text" id="title" name="title" required>
      </div>

      <div class="form-group file-box">
        <label for="photo">Select Image</label>
        <input type="file" id="photo" name="photo" required>
      </div>

      <button type="submit" class="upload-btn">Upload Notice</button>
    </form>
  </div>
</div>

</body>
</html>